<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CineSuggest</title>
    <link rel="stylesheet" href="/style3.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
        rel="stylesheet">

</head>

<body>
    <nav>
        <div id="NavBar">
            <div id="TitleBox">

                <i class="fa-solid fa-film"></i>


                <p class="google-sans-custom" id="Pagetitle">CineSuggest</p>
            </div>

            <div id="NavMenu">
                <p class="google-sans-monteserrat">Home</p>
                <p class="google-sans-monteserrat">Discover</p>
                <p class="google-sans-monteserrat">Watchlist</p>

                <select name="Genre" id="Dropdown" class="google-sans-monteserrat">
                    <option value="" selected id="Default">Genre</option>
                    <option value="Fantasy">Fantasy</option>
                    <option value="Adventure">Adventure</option>
                    <option value="Action">Action</option>
                    <option value="Drama">Drama</option>
                    <option value="Comedy">Comedy</option>
                    <option value="Horror">Horror</option>
                    <option value="Crime">Crime</option>
                    <option value="Sci-Fi">Sci-Fi</option>x
                </select>



                <!-- <img src="c:\Users\mahit\Downloads\sun-regular-full.svg" alt="Settings Icon"> -->
            </div>
            <div id="NavRemaining">
                <div id="SearchBox">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" placeholder="Search movies,shows..." id="Searchbar" name="Title">
                </div>
                <i class="fa-regular fa-bell icons"></i>
                <i class="fa-regular fa-circle-user icons"></i>
            </div>

        </div>
    </nav>

    <div id="MainDisplaySection">
        <div id="ImageContent">
            <p class="dm-sans-trending">#1 TRENDING</p>
            <h2 class="google-sans-title">Interstellar</h2>
            <ul>
                <p>2014</p>
                <li> Sci-Fi</li>
                <li> 2h 49m</li>
            </ul>
            <p class="inter-description">A team of explorers travel through a wormhole in space in an attempt to ensure
                humanity's survival</p>
        </div>
        <img src="https://i.guim.co.uk/img/static/sys-images/Guardian/Pix/pictures/2014/11/5/1415201794019/Matthew-McConaughey-in-In-014.jpg?width=700&quality=85&auto=format&fit=max&s=7ca85dcd8787f3c9ff63fb2213085f40"
            alt="">
    </div>

    <section>
        <div id="CategorySection">
            <div>
                <p>All</p>
            </div>
            <div>
                <p>Action</p>
            </div>
            <div>
                <p>Comedy</p>
            </div>
            <div>
                <p>Drama</p>
            </div>
            <div>
                <p>SciFi</p>
            </div>
            <div>
                <p>Thriller</p>
            </div>
            <div>
                <p>Horror</p>
            </div>
            <div>
                <p>Animation</p>
            </div>
            <div>
                <p>Romance</p>
            </div>

        </div>
    </section>

    <section>
        <div id="Popularsection">
            <% for(let i=0; i<movies.length; i++) { %>
                <div class="Moviecontent">
                    <img src=" <%= movies[i].poster %>"
                        alt="MovieImg" class="MovieImg">
                    <div>
                        <p class="Imagetitle montserrat-title"><%= movies[i].title %></p>
                        <p class="Rating"><i class="fa-solid fa-star styling"></i> <%= movies[i].rating %></p>
                    </div>
                    <p class="Year"><%= movies[i].year %></p>
                </div>
            <% } %>
        </div>
    </section>
    
    <script src="/script.js"></script>
</body>

</html>