<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Watchlist</title>
    <link rel="stylesheet" href="/watchlistStyle.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
        rel="stylesheet">
    <link rel="icon"
        href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQRSxxCW2NXs0YKgunIPc0lDAGqiwei2JkDZf-xynDD5JO3JznQaNq0mDQ&s=10">
</head>

<body>
    <% for(let i=0; i<watchlist.length; i++) { %>
        <div class="MainWrapper">
            <div id="MainDisplaySection">
                <img src="<%= watchlist[i].poster %>" alt="" id="Image">
                <div id="ImageContent">
                    <div id="TitleBox">
                        <h2 class="google-sans-title"><%= watchlist[i].title %></h2>
                        <i class="fa-regular fa-trash-can"></i>
                    </div>
                    <ul>
                        <p>
                            <%= watchlist[i].year %>
                        </p>
                        <li>
                            <%= watchlist[i].genre[0] %>
                        </li>
                        <li>
                            <%= watchlist[i].duration %>
                        </li>
                    </ul>
                    <p class="inter-description">
                        <%= watchlist[i].description %>
                    </p>
                </div>
            </div>
            <hr>
        </div>
        <% } %>

            <!-- PopupBox Asking to whether Confirm Delete or not? -->
            <div id="Overlay">
                <div id="AlertBox">
                    <p class="inter-homo">Do you Want To Add Interstellar To the Watchlist?</p>
                    <div>
                        <button>Yes</button>
                        <button>No</button>
                    </div>
                </div>
            </div>


            <script src="/WatchListScript.js"></script>


</body>

</html>